# PostgreSQL (Neon / Supabase / Local)
DATABASE_URL="postgres://postgres@localhost:5432/lki_v2_db"
DIRECT_URL="postgres://postgres@localhost:5432/lki_v2_db"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security Secrets (Wajib diisi >= 32 karakter acak via: openssl rand -hex 32)
ADMIN_JWT_SECRET=""
CITIZEN_JWT_SECRET=""
CRON_SECRET=""
IP_HASH_SALT=""

# Bootstrap Initial Super Admin (hanya dipakai saat db:bootstrap-admin)
INITIAL_SUPERADMIN_USERNAME="superadmin"
INITIAL_SUPERADMIN_PASSWORD=""

# Optional Integrations
GEMINI_API_KEY=""
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
RESEND_API_KEY=""
EMAIL_FROM="LKI Transparansi <noreply@localhost>"
